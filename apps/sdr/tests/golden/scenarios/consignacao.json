{
  "name": "consignacao",
  "description": "Cliente quer consignar o veículo na loja. Roteiro de coleta de informações do veículo.",
  "initial_state": {},
  "turns": [
    {
      "inbound": "Quero deixar meu carro em consignação na FacilCar",
      "understand_return": {"intent": "CONSIGNMENT", "facts": {}},
      "expected_action": "ASK_INFO",
      "expected_ask_field_in": ["trade_model", "trade_year"]
    },
    {
      "inbound": "É um Civic 2021 preto 30000 km, quitado",
      "understand_return": {"intent": "CONSIGNMENT", "facts": {"trade_model": "Honda Civic", "trade_year": "2021", "trade_color": "preto", "mileage": 30000, "trade_has_financing": "false"}},
      "expected_action": "ASK_INFO",
      "expected_facts_after": {"trade_model": "honda civic", "trade_year": "2021"},
      "expected_ask_field_in": ["trade_has_debts", "trade_price_expectation"]
    },
    {
      "inbound": "Sem débitos, espero 75 mil",
      "understand_return": {"intent": "CONSIGNMENT", "facts": {"trade_has_debts": "false", "trade_price_expectation": 75000}},
      "expected_action": "ASK_INFO",
      "expected_facts_after": {"trade_price_expectation": 75000},
      "expected_ask_field_in": ["leave_at_store", "name"]
    }
  ]
}
