{
  "name": "compra_avista",
  "description": "Compra à vista. Roteiro: interesse → modelo → deal_type=purchase → nome → handoff.",
  "initial_state": {},
  "turns": [
    {
      "inbound": "Quero comprar um Onix",
      "understand_return": {"intent": "PURCHASE", "facts": {"desired_model": "Onix"}},
      "expected_action": "SHOW_OFFERS",
      "expected_facts_after": {"desired_model": "onix"}
    },
    {
      "inbound": "Compra mesmo, à vista",
      "understand_return": {"intent": "PURCHASE", "facts": {"deal_type": "purchase", "payment_method": "cash"}},
      "expected_action": "ASK_INFO",
      "expected_facts_after": {"deal_type": "purchase"},
      "expected_ask_field_in": ["name"]
    },
    {
      "inbound": "Me chamo Lucas Rocha",
      "understand_return": {"intent": "PURCHASE", "facts": {"name": "Lucas Rocha"}},
      "expected_facts_after": {"name": "Lucas Rocha"}
    }
  ]
}
