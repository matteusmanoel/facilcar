# FacilCar Júlia SDR (Python worker)
# Uso: cp .env.example .env  →  edite UM bloco
# DATABASE_URL deve ser igual ao apps/web/.env.local

# ═══════════════════════════════════════════════════════════════════
# LOCAL
# ═══════════════════════════════════════════════════════════════════

DATABASE_URL=
REDIS_URL=redis://localhost:6379/0

SDR_WEBHOOK_SECRET=
JULIA_ENABLED=true

EVOLUTION_API_URL=http://localhost:8081
EVOLUTION_API_KEY=
EVOLUTION_SDR_INSTANCE=facilcar-sdr

OPENAI_API_KEY=
SDR_UNDERSTANDING_MODEL=gpt-4.1-mini
SDR_RESPONSE_MODEL=gpt-4.1-mini
# false (default): persist the validated deterministic CRM summary (no extra LLM call).
# true: optional style pass; rejected LLM drafts never persist.
SDR_SUMMARY_LLM=false
SDR_VISION_MODEL=gpt-4o
# sandbox: falha de mídia/tool pode incluir o código na mensagem.
# production: falha de mídia/tool = silêncio (humano assume).
SDR_ENVIRONMENT=sandbox

# CNH/CRLV — mesmo bucket do admin (vehicle-images), prefixo customer-documents/{customerId}/
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET_NAME=vehicle-images
SDR_DOCUMENTS_BUCKET=vehicle-images

# ═══════════════════════════════════════════════════════════════════
# PROD — VPS / docker-compose.sdr.prod.yml
# ═══════════════════════════════════════════════════════════════════

# DATABASE_URL=postgresql://postgres.PROJ_REF:...@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# (Transaction pooler :6543 — asyncpg already sets statement_cache_size=0 + ssl=require)
# Habilitar schema na Data API NÃO afeta o worker SDR (usa Postgres direto via asyncpg).
# Replay com estoque real: python -m sdr.replay --with-db --mode live <fixture>
# REDIS_URL=redis://redis:6379/0
# SDR_WEBHOOK_SECRET=
# JULIA_ENABLED=true
# EVOLUTION_API_URL=https://...
# EVOLUTION_API_KEY=
# OPENAI_API_KEY=
