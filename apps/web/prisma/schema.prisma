// Auto Dealer MVP - Prisma schema v1
// Tabelas no schema PostgreSQL `facilcar` (convive com outros apps no mesmo projeto Supabase).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["facilcar"]
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  LEAD_MANAGER

  @@schema("facilcar")
}

enum VehicleStatus {
  DRAFT
  PUBLISHED
  RESERVED
  SOLD
  ARCHIVED

  @@schema("facilcar")
}

enum VehicleType {
  CAR
  MOTORCYCLE
  UTILITY
  OTHER

  @@schema("facilcar")
}

enum FuelType {
  GASOLINE
  ETHANOL
  FLEX
  DIESEL
  ELECTRIC
  HYBRID
  OTHER

  @@schema("facilcar")
}

enum Transmission {
  MANUAL
  AUTOMATIC
  AUTOMATED
  CVT
  OTHER

  @@schema("facilcar")
}

enum LeadType {
  CONTACT
  VEHICLE_INTEREST
  FINANCING
  SELL_VEHICLE
  REFINANCING
  TRADE_IN
  CONSIGNMENT
  THIRD_PARTY_FINANCING

  @@schema("facilcar")
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  CONTACTED
  QUALIFIED
  WON
  LOST
  SPAM

  @@schema("facilcar")
}

enum LeadSource {
  HOME
  CATALOG
  VEHICLE_PAGE
  CONTACT_PAGE
  FINANCING_PAGE
  SELL_PAGE
  BLOG
  WHATSAPP
  UNKNOWN

  @@schema("facilcar")
}

enum LeadChannel {
  FORM
  WHATSAPP
  MANUAL

  @@schema("facilcar")
}

enum PageStatus {
  DRAFT
  PUBLISHED

  @@schema("facilcar")
}

enum PostStatus {
  DRAFT
  PUBLISHED

  @@schema("facilcar")
}

enum VehicleFeatureCategory {
  COMFORT
  SAFETY
  TECH
  EXTERIOR
  OTHER

  @@schema("facilcar")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  assignedLeads Lead[]

  @@schema("facilcar")
}

model Brand {
  id       String   @id @default(cuid())
  name     String   @unique
  slug     String   @unique
  logoUrl  String?
  isActive Boolean  @default(true)
  vehicles Vehicle[]

  @@schema("facilcar")
}

model Vehicle {
  id                String         @id @default(cuid())
  slug              String         @unique
  status            VehicleStatus
  type              VehicleType
  title             String
  shortDescription  String?
  description       String?
  brandId           String
  brand             Brand          @relation(fields: [brandId], references: [id], onDelete: Restrict)
  model             String
  version           String?
  yearManufacture   Int?
  yearModel         Int?
  mileage           Int?
  fuelType          FuelType?
  transmission      Transmission?
  engineDisplacementLiters Decimal? @db.Decimal(3, 1)
  color             String?
  doors             Int?
  plateFinal        String?
  priceCash         Decimal?       @db.Decimal(12, 2)
  priceTradeIn      Decimal?       @db.Decimal(12, 2)
  pricePromotional  Decimal?       @db.Decimal(12, 2)
  city              String?
  state             String?
  featured             Boolean        @default(false)
  aceitaTroca          Boolean        @default(false)
  aceitaSemEntrada     Boolean        @default(false)
  parcelaBase          Decimal?       @db.Decimal(12, 2)
  entradaMinima        Decimal?       @db.Decimal(12, 2)
  rendaMinimaSugerida  Decimal?       @db.Decimal(12, 2)
  prioridade           Int            @default(0)
  publishedAt          DateTime?
  metaTitle            String?
  metaDescription      String?
  createdAt            DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  images            VehicleImage[]
  features          VehicleFeature[]
  leads             Lead[]
  financingRequests FinancingRequest[]

  @@schema("facilcar")
  @@index([status])
  @@index([featured])
  @@index([brandId])
  @@index([priceCash])
  @@index([fuelType])
  @@index([transmission])
  @@index([publishedAt])
}

model VehicleImage {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int
  isCover   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@schema("facilcar")
}

model VehicleFeature {
  id        String                 @id @default(cuid())
  vehicleId String
  vehicle   Vehicle                @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  label     String
  category  VehicleFeatureCategory
  sortOrder Int

  @@schema("facilcar")
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  leads     Lead[]

  @@schema("facilcar")
  @@index([name])
}

model Lead {
  id               String       @id @default(cuid())
  type             LeadType
  status           LeadStatus   @default(NEW)
  source           LeadSource
  channel          LeadChannel
  name             String
  email            String?
  phone            String
  whatsapp         String?
  city             String?
  state            String?
  message          String?
  vehicleId        String?
  vehicle          Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  customerId       String?
  customer         Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedToUserId String?
  assignedToUser    User?        @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull)
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmTerm          String?
  utmContent       String?
  originUrl        String?
  metadataJson     Json?
  internalNote     String?
  deletedAt        DateTime?
  juliaSummary     String?
  temperature      LeadTemperature?
  conversationId   String?
  conversation     Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  financingRequest FinancingRequest?
  sellRequest      SellRequest?
  visitInterests   VisitInterest[]
  sdrDocuments     SdrDocument[]
  sdrNotifications SdrNotification[]

  @@schema("facilcar")
  @@index([type])
  @@index([status])
  @@index([source])
  @@index([customerId])
  @@index([deletedAt])
  @@index([createdAt(sort: Desc)])
  @@index([conversationId])
}

model FinancingRequest {
  id                  String    @id @default(cuid())
  leadId              String    @unique
  lead                Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  vehicleId           String?
  vehicle             Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  cpf                 String?
  birthDate           DateTime?
  hasDriverLicense    Boolean?
  downPayment         Decimal?  @db.Decimal(12, 2)
  desiredInstallments Int?
  monthlyIncome       Decimal?  @db.Decimal(12, 2)
  vehicleYear         Int?
  vehicleModel        String?
  occupation          String?
  notes               String?

  @@schema("facilcar")
}

model SellRequest {
  id              String   @id @default(cuid())
  leadId          String   @unique
  lead            Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  brand           String?
  model           String?
  version         String?
  yearManufacture Int?
  yearModel       Int?
  mileage         Int?
  fuelType        String?
  transmission    String?
  observations    String?

  @@schema("facilcar")
}

model Page {
  id              String     @id @default(cuid())
  slug            String     @unique
  title           String
  excerpt         String?
  body            String
  status          PageStatus
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@schema("facilcar")
}

model BlogPost {
  id            String     @id @default(cuid())
  slug          String     @unique
  title         String
  excerpt       String?
  coverImageUrl String?
  body          String
  status        PostStatus
  publishedAt   DateTime?
  metaTitle     String?
  metaDescription String?
  createdAt     DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@schema("facilcar")
}

model SiteSettings {
  id                   String   @id @default(cuid())
  siteName             String
  defaultWhatsappNumber String
  defaultEmail         String
  phoneNumber         String?
  addressLine         String?
  city                String?
  state               String?
  zipCode             String?
  facebookUrl         String?
  instagramUrl       String?
  youtubeUrl          String?
  seoDefaultTitle     String?
  seoDefaultDescription String?
  footerText          String?
  heroTitle           String?
  heroSubtitle        String?
  publicTheme         String   @default("dark")

  @@schema("facilcar")
}

enum CatalogEventStatus {
  RECEIVED
  QUEUED
  PROCESSING
  PROCESSED
  IGNORED
  FAILED

  @@schema("facilcar")
}

enum CatalogItemStatus {
  COLLECTING
  READY
  PROCESSING
  IMPORTED
  FAILED

  @@schema("facilcar")
}

enum CatalogMediaStatus {
  PENDING
  UPLOADED
  FAILED
  SKIPPED_DEDUPED

  @@schema("facilcar")
}

enum CatalogTextKind {
  VEHICLE_START
  CONTINUATION
  MEDIA_ONLY
  UNKNOWN

  @@schema("facilcar")
}

model CatalogImportEvent {
  id                  String              @id @default(cuid())
  instance            String
  messageId           String
  remoteJid           String?
  fromMe              Boolean
  messageType         String?
  textKind            CatalogTextKind?
  waTimestamp         DateTime?
  sequence            Int
  payloadHash         String
  rawPayload          Json
  rawPayloadTruncated Boolean             @default(false)
  text                String?
  hasMedia            Boolean             @default(false)
  mediaRef            Json?
  mediaStatus         CatalogMediaStatus?
  processingStatus    CatalogEventStatus  @default(RECEIVED)
  importItemId        String?
  importItem          CatalogImportItem?  @relation(fields: [importItemId], references: [id])
  error               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([instance, messageId])
  @@index([processingStatus, createdAt])
  @@index([importItemId, sequence])
  @@schema("facilcar")
}

model CatalogImportItem {
  id                 String             @id @default(cuid())
  sessionKey         String
  sourceMessageId    String?
  rawText            String?
  parsedJson         Json?
  vehicleFingerprint String?
  status             CatalogItemStatus  @default(COLLECTING)
  vehicleId          String?
  lockedAt           DateTime?
  lockedBy           String?
  attemptCount       Int                @default(0)
  lastAttemptAt      DateTime?
  idleClosedAt       DateTime?
  completedAt        DateTime?
  error              String?
  warnings           String[]           @default([])
  events             CatalogImportEvent[]
  mediaAssets        CatalogMediaAsset[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([sessionKey, status])
  @@index([status, lockedAt])
  @@index([vehicleFingerprint])
  @@schema("facilcar")
}

model CatalogMediaBlob {
  id         String              @id @default(cuid())
  sha256     String              @unique
  storageKey String
  publicUrl  String
  mimeType   String?
  byteSize   Int?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  assets     CatalogMediaAsset[]

  @@schema("facilcar")
}

model CatalogMediaAsset {
  id           String             @id @default(cuid())
  importItemId String
  importItem   CatalogImportItem  @relation(fields: [importItemId], references: [id], onDelete: Cascade)
  eventId      String?            @unique
  blobId       String?
  blob         CatalogMediaBlob?  @relation(fields: [blobId], references: [id])
  sortOrder    Int                @default(0)
  status       CatalogMediaStatus @default(PENDING)
  error        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([importItemId, sortOrder])
  @@schema("facilcar")
}

// --- Júlia SDR core (WP-000) ---

enum ConversationBotStatus {
  BOT_ACTIVE
  QUALIFYING
  READY_FOR_HANDOFF
  HANDOFF_SENT
  HUMAN_ACTIVE
  HUMAN_CLOSED

  @@schema("facilcar")
}

enum MessageDirection {
  INBOUND
  OUTBOUND

  @@schema("facilcar")
}

enum MessageContentType {
  TEXT
  AUDIO
  IMAGE
  DOCUMENT
  VIDEO
  STICKER
  UNKNOWN

  @@schema("facilcar")
}

enum SdrDocumentType {
  CNH
  CRLV
  INCOME_PROOF
  RESIDENCE_PROOF
  OTHER

  @@schema("facilcar")
}

enum SdrDocumentExtractionStatus {
  PENDING
  DONE
  FAILED

  @@schema("facilcar")
}

enum SdrRetentionPolicy {
  PERMANENT
  DAYS_180

  @@schema("facilcar")
}

enum SdrNotificationType {
  NEW_QUALIFIED
  NEW_HOT_LEAD

  @@schema("facilcar")
}

enum LeadTemperature {
  HOT
  WARM
  COLD

  @@schema("facilcar")
}

model Conversation {
  id                  String                @id @default(cuid())
  phone               String
  instanceName        String
  botStatus           ConversationBotStatus @default(BOT_ACTIVE)
  language            String?
  accumulatedSummary  String?
  lastMessageAt       DateTime?
  activeLeadIds       String[]              @default([])
  handoffAt           DateTime?
  canonicalStateJson  Json?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  messages            Message[]
  leads               Lead[]
  visitInterests      VisitInterest[]
  sdrDocuments        SdrDocument[]

  @@unique([instanceName, phone])
  @@index([phone])
  @@schema("facilcar")
}

model Message {
  id                String             @id @default(cuid())
  conversationId    String
  conversation      Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  providerMessageId String
  instanceName      String
  direction         MessageDirection
  contentType       MessageContentType
  text              String?
  mediaStorageKey   String?
  mediaMimeType     String?
  transcription     String?
  fromMe            Boolean
  isHumanSent       Boolean            @default(false)
  isBotSent         Boolean            @default(false)
  language          String?
  turnFactsJson     Json?
  processingStatus  String?            @default("PENDING")
  createdAt         DateTime           @default(now())
  processedAt       DateTime?

  @@unique([instanceName, providerMessageId])
  @@index([conversationId, createdAt])
  @@schema("facilcar")
}

model VisitInterest {
  id             String        @id @default(cuid())
  leadId         String
  lead           Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  dateHint       String?
  period         String?
  notes          String?
  createdAt      DateTime      @default(now())

  @@index([leadId])
  @@index([conversationId])
  @@schema("facilcar")
}

model SdrDocument {
  id               String                       @id @default(cuid())
  leadId           String?
  lead             Lead?                        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  conversationId   String?
  conversation     Conversation?                @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  documentType     SdrDocumentType
  storageKey       String
  mimeType         String?
  byteSize         Int?
  extractedJson    Json?
  extractionStatus SdrDocumentExtractionStatus  @default(PENDING)
  retentionPolicy  SdrRetentionPolicy           @default(DAYS_180)
  expiresAt        DateTime?
  createdAt        DateTime                     @default(now())

  @@index([leadId])
  @@index([conversationId])
  @@schema("facilcar")
}

model SdrNotification {
  id           String              @id @default(cuid())
  leadId       String
  lead         Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type         SdrNotificationType
  seenAt       DateTime?
  seenByUserId String?
  createdAt    DateTime            @default(now())

  @@index([seenAt, createdAt])
  @@index([leadId])
  @@schema("facilcar")
}
