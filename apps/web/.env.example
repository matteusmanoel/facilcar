# FacilCar Web (Next.js)
# Uso: cp .env.example .env.local  →  edite UM bloco abaixo
# Local = apps/web/.env.local | Prod = painel Vercel (não commitar)

# ═══════════════════════════════════════════════════════════════════
# LOCAL — dev na sua máquina
# ═══════════════════════════════════════════════════════════════════

# Postgres Docker (npm run setup): postgres:postgres@127.0.0.1:5432/facilcar
# Supabase remoto (estoque real): pooler porta 6543 + ?pgbouncer=true&sslmode=require
DATABASE_URL=

# Sessão Auth.js admin — openssl rand -base64 32
AUTH_SECRET=

AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=5545988432998

# OpenAI — Júlia + catalog import
OPENAI_API_KEY=

# Evolution local (docker-compose.evolution.yml) — apikey = AUTHENTICATION_API_KEY
EVOLUTION_API_URL=http://localhost:8081
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=facilcar
EVOLUTION_SDR_INSTANCE=facilcar-sdr

# Júlia SDR — relay Next → worker Python
SDR_WEBHOOK_SECRET=
JULIA_ENABLED=true
SDR_API_URL=http://localhost:8000
# sandbox | staging | production — ingest deny-by-default unless allowlisted
SDR_ENVIRONMENT=sandbox
# deny_all | allowlist | unrestricted (unrestricted only in production)
SDR_OUTBOUND_POLICY=deny_all
SDR_OUTBOUND_ALLOWLIST=

# Ngrok NÃO entra aqui. No painel Evolution → webhook da instância facilcar-sdr:
#   URL:    https://SEU-TUNNEL.ngrok-free.dev/api/webhooks/sdr
#   Header: x-sdr-secret = SDR_WEBHOOK_SECRET

# Catalog import (WhatsApp → veículos DRAFT)
CATALOG_IMPORT_SECRET=
CATALOG_IMPORT_ALLOWED_JIDS=
CATALOG_IMPORT_MODE=inspect

# Supabase Storage S3 — fotos de veículos (opcional se só testar texto)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET_NAME=vehicle-images
STORAGE_S3_REGION=sa-east-1
STORAGE_PUBLIC_URL=

# Documentos Júlia (CNH) — bucket privado no Supabase. Nunca vehicle-images.
SDR_DOCUMENTS_BUCKET=sdr-documents

# E2E Playwright — seed local: admin@facilcar.demo / ChangeMe123!
E2E_ADMIN_EMAIL=admin@facilcar.demo
E2E_ADMIN_PASSWORD=ChangeMe123!

# ═══════════════════════════════════════════════════════════════════
# PROD — copiar para Vercel (Environment Variables)
# ═══════════════════════════════════════════════════════════════════

# DATABASE_URL=postgresql://postgres.PROJ_REF:...@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
# DATABASE_URL_DIRECT=postgresql://postgres:...@db.PROJ_REF.supabase.co:5432/postgres?sslmode=require
