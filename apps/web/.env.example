# Copy to apps/web/.env for local development:
#   cp apps/web/.env.example apps/web/.env
#
# Quick start from repo root:
#   npm run setup
#   npm run dev
#
# Login demo: admin@facilcar.demo / ChangeMe123!

# === Obrigatórias (MVP) ===
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/facilcar"

# Auth.js — gerar: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# === Recomendadas (local) ===
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="5545999999999"

# Supabase (produção / storage remoto — opcional no dev local)
NEXT_PUBLIC_SUPABASE_HOST=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Storage — Cloudflare R2 OU Supabase Storage (API S3)
# STORAGE_ENDPOINT=
# STORAGE_S3_REGION=us-east-1
# STORAGE_BUCKET_NAME=vehicle-images
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_PUBLIC_URL=

# Optional: Resend, Turnstile, PostHog, Sentry

# Playwright E2E
E2E_ADMIN_EMAIL="admin@facilcar.demo"
E2E_ADMIN_PASSWORD="ChangeMe123!"
