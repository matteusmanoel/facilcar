# Evolution API — stack WhatsApp local (sempre local, nunca Vercel)
# Uso: cp .env.evolution.example .env.evolution
#       npm run evolution:up
#
# Repita AUTHENTICATION_API_KEY em EVOLUTION_API_KEY (web + sdr)

AUTHENTICATION_API_KEY=
SERVER_URL=http://localhost:8081

POSTGRES_PASSWORD=
REDIS_PASSWORD=

CONFIG_SESSION_PHONE_CLIENT=Chrome
CONFIG_SESSION_PHONE_NAME=Chrome
